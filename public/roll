#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# FILE: public/roll        (served at https://ishu0505.tech/roll)
#
# WHAT IT DOES
#   The reward for finding the easter egg: plays a short tune and shows a dancing
#   raccoon in your terminal for about 14 seconds.
#
# IS IT SAFE?  Read it first:   curl -sL https://ishu0505.tech/roll
#   - It downloads ONE file (jingle.wav) from this site into a temporary folder.
#   - It plays it with a player that is already on your computer (afplay / paplay /
#     aplay / play / ffplay). If you have none, you just get the animation.
#   - It then deletes the temporary folder. It does not touch anything else.
#   - Ctrl+C stops it at any time and restores your terminal.
#
# SETTINGS (optional environment variables)
#   EASTER_EGG_SITE      where to fetch jingle.wav from   (default https://ishu0505.tech)
#   EASTER_EGG_SECONDS   how long to run                  (default 14)
#   EASTER_EGG_COUNTDOWN seconds of "3, 2, 1" before it starts (default 3)
#   EASTER_EGG_ANYWAY=1  run even if the output is not a terminal
# ---------------------------------------------------------------------------

SITE="${EASTER_EGG_SITE:-https://ishu0505.tech}"
SECONDS_TO_RUN="${EASTER_EGG_SECONDS:-14}"
COUNTDOWN="${EASTER_EGG_COUNTDOWN:-3}"

# Animation needs a real terminal. If the output goes to a file or another command, say so and stop.
if [ ! -t 1 ] && [ -z "$EASTER_EGG_ANYWAY" ]; then
  echo "This one needs a terminal. Run it like this:  curl -sL $SITE/roll | bash"
  exit 0
fi

WORK_DIR="$(mktemp -d 2>/dev/null || mktemp -d -t egg)"   # a private temporary folder
AUDIO_PID=""

# Always tidy up when we stop (finished, Ctrl+C, or an error): stop the sound,
# delete the temp folder, show the cursor again, reset colours.
cleanup() {
  [ -n "$AUDIO_PID" ] && kill "$AUDIO_PID" 2>/dev/null
  rm -rf "$WORK_DIR"
  printf '\033[?25h\033[0m\n'
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# ---- 1. get the tune -------------------------------------------------------
# (time limits: if the site is slow we just skip the sound instead of hanging)
curl -fsSL --connect-timeout 5 --max-time 20 "$SITE/jingle.wav" -o "$WORK_DIR/jingle.wav" 2>/dev/null

# ---- 2. play it quietly in the background with whatever player exists ------
play_tune() {
  [ -s "$WORK_DIR/jingle.wav" ] || return 1
  if   command -v afplay >/dev/null 2>&1; then afplay "$WORK_DIR/jingle.wav" >/dev/null 2>&1 &            # macOS
  elif command -v paplay >/dev/null 2>&1; then paplay "$WORK_DIR/jingle.wav" >/dev/null 2>&1 &            # Linux (PulseAudio / PipeWire)
  elif command -v aplay  >/dev/null 2>&1; then aplay -q "$WORK_DIR/jingle.wav" >/dev/null 2>&1 &          # Linux (ALSA)
  elif command -v play   >/dev/null 2>&1; then play -q "$WORK_DIR/jingle.wav" >/dev/null 2>&1 &           # SoX
  elif command -v ffplay >/dev/null 2>&1; then ffplay -nodisp -autoexit -loglevel quiet "$WORK_DIR/jingle.wav" >/dev/null 2>&1 &
  else return 1
  fi
  AUDIO_PID=$!
}

# ---- 3. a little countdown so nobody is startled --------------------------
printf '\033[1;35mStarting in 3... 2... 1...   (Ctrl+C to stop)\033[0m\n'
sleep "$COUNTDOWN"

HAS_SOUND=1
play_tune || HAS_SOUND=0
printf '\033[?25l'   # hide the cursor while we animate

# ---- 4. the animation: four frames of a dancing raccoon -------------------
FRAMES=(
'
       /\___/\
      ( o   o )      ♪   ♫
      (  =^=  )
     \_/ )   ( \_/
        /|   |\
       d_|   |_b
'
'
       /\___/\
      ( ^   ^ )    ♫   ♪
      (  =^=  )
      _\ )   ( /_
         |   |
        /|   |\
'
'
       /\___/\
      ( o   o )      ♪   ♫
      (  =^=  )
       \_)   (_/
        \|   |/
        _|   |_
'
'
       /\___/\
      ( >   < )    ♫   ♪
      (  =^=  )
     \_/ )   ( \_/
         |   |
        d|   |b
'
)

END_AT=$((SECONDS + SECONDS_TO_RUN))
while [ "$SECONDS" -lt "$END_AT" ]; do
  for frame in "${FRAMES[@]}"; do
    printf '\033[H\033[2J'                      # clear the screen
    printf '\033[1;33m   You found the easter egg!\033[0m\n'
    printf '\033[1;35m%s\033[0m\n' "$frame"
    [ "$HAS_SOUND" = 0 ] && printf '\033[90m   (no audio player found, so this one is silent)\033[0m\n'
    sleep 0.3
  done
done

printf '\033[H\033[2J\033[1;32mThanks for visiting! Say hi: iparmar0505@gmail.com\033[0m\n'
